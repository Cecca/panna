 import pynndescent.sparse_nndescent as sparse_nnd
 import pynndescent.distances as pynnd_dist
 
+# ---------------------------------------------------------------------------
+# Distance-computation counting (local patch).
+#
+# Wraps the metric distance function so that every metric evaluation performed
+# by NNDescent (both graph construction and querying) is counted.  Counting is
+# thread-safe: each numba worker thread increments its own slot of a small
+# ctypes buffer, and the slots are summed when read.  Inspect the count via
+# ``pynndescent.distance_count()`` and clear it with
+# ``pynndescent.reset_distance_count()``.
+# ---------------------------------------------------------------------------
+import ctypes as _ctypes
+from numba import types as _nb_types
+from numba.extending import intrinsic as _intrinsic
+from numba.core import cgutils as _cgutils
+
+
+@_intrinsic
+def _address_as_void_pointer(typingctx, src):
+    """Reinterpret a raw integer address as a numba void pointer."""
+    sig = _nb_types.voidptr(src)
+
+    def codegen(cgctx, builder, sig, args):
+        return builder.inttoptr(args[0], _cgutils.voidptr_t)
+
+    return sig, codegen
+
+
+_DIST_COUNT_NTHREADS = numba.config.NUMBA_NUM_THREADS
+_dist_count_buffer = (_ctypes.c_int64 * _DIST_COUNT_NTHREADS)()
+_dist_count_addr = _ctypes.addressof(_dist_count_buffer)
+
+
+def reset_distance_count():
+    """Reset the global distance-computation counter to zero."""
+    for _i in range(_DIST_COUNT_NTHREADS):
+        _dist_count_buffer[_i] = 0
+
+
+def distance_count():
+    """Return the number of metric distance evaluations counted so far."""
+    return int(sum(_dist_count_buffer))
+
+
+def _wrap_distance_counting(distance_func):
+    """Wrap a 2-argument njit distance function so each call is counted."""
+    _addr = _dist_count_addr
+    _n = _DIST_COUNT_NTHREADS
+
+    @numba.njit()
+    def _counted_distance_func(x, y):
+        _slots = numba.carray(_address_as_void_pointer(_addr), _n, dtype=np.int64)
+        _slots[numba.get_thread_id()] += 1
+        return distance_func(x, y)
+
+    return _counted_distance_func
+
